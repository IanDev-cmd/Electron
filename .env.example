# TEST keys first: https://dashboard.paystack.com/#/settings/developers
# Switch BOTH to live (sk_live_ / pk_live_) when your Paystack business is activated.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional until Paystack sends the Paystack-Signature header. From Developers > API configuration.
PAYSTACK_WEBHOOK_SECRET=

# The charge is always $50.00 USD. 5000 is the amount in cents.
PAYSTACK_CURRENCY=USD
PRICE_MINOR=5000

# Postgres connection string. Required in production; leave empty locally to use in-memory dev storage.
DATABASE_URL=

PORT=3000

# Download alerts go to this inbox. SMTP must be set or the email is skipped
# and the download still appears on /health.
NOTIFY_EMAIL_TO=iank.njenga@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
