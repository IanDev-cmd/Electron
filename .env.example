# TEST keys first: https://dashboard.paystack.com/#/settings/developers
# Switch BOTH to live (sk_live_ / pk_live_) when your Paystack business is activated.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Fixed price, server-side only. 5000 minor units = 50.00. Currency must be enabled on your Paystack account.
PAYSTACK_CURRENCY=USD
PRICE_MINOR=5000

# Postgres connection string. Required in production; leave empty locally to use in-memory dev storage.
DATABASE_URL=

PORT=3000
